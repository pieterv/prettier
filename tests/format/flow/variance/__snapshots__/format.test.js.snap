// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`variance.js format 1`] = `
====================================options=====================================
parsers: ["flow"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
class Route {
  static +param: T;
}

class ReadonlyRoute {
    static   readonly   param: T;
}

type ReadonlyObj = {
    readonly   foo:   string,
  readonly [string]:   unknown
};

type ReadonlyTuple = [  readonly   label:   number  ];

type ReadonlyInterface = interface {
      readonly   prop:   string
};

=====================================output=====================================
class Route {
  static +param: T;
}

class ReadonlyRoute {
  static readonly param: T;
}

type ReadonlyObj = {
  readonly foo: string,
  readonly [string]: unknown,
};

type ReadonlyTuple = [readonly label: number];

type ReadonlyInterface = interface {
  readonly prop: string,
};

================================================================================
`;
